{
  "project_dir": ".",
  "executor": "codex",
  "research_execution_paused": true,
  "bounded_task": "config/orchestration/c01_s2_admission.json",
  "max_iterations": 20,
  "executor_timeout_seconds": 10800,
  "planner_timeout_seconds": 1800,
  "max_result_chars_for_planner": 60000,
  "recent_history_items_for_planner": 4,
  "stop_on_executor_error": true,
  "min_iterations_before_done": 1,
  "done_confirmation_required": false,
  "codex": {
    "command": "codex",
    "model": "gpt-5.6-sol",
    "sandbox": "danger-full-access",
    "extra_args": [
      "--config",
      "sandbox_workspace_write.network_access=true"
    ],

    "executor_model": "gpt-5.6-terra",
    "executor_sandbox": "danger-full-access",
    "executor_approval_policy": "never",
    "executor_extra_args": [
      "--config",
      "sandbox_workspace_write.network_access=true"
    ]
  },
  "claude": {
    "command": "claude",
    "model": "sonnet",
    "extra_args": [
      "--output-format",
      "json",
      "--max-turns",
      "60",
      "--dangerously-skip-permissions"
    ]
  },
  "antigravity": {
    "command": "agy",
    "extra_args": [
      "--print-timeout",
      "120m",
      "--output-format",
      "stream-json"
    ]
  }
}
