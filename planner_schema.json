{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "analysis", "next_task"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["continue", "done"]
    },
    "analysis": {
      "type": "string"
    },
    "next_task": {
      "type": "string"
    }
  }
}
